# ─────────────────────────────────────────────────────────────────────────────
# Wisal (وصال) — environment configuration
# Copy to .env and fill in the values marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# docker compose builds DATABASE_URL from these; use a URL-safe password
# (e.g. `openssl rand -hex 24`).
POSTGRES_DB=medvisit
POSTGRES_USER=medvisit
POSTGRES_PASSWORD=change-me-REQUIRED
# Only needed when running the app outside docker compose (npm run dev / start):
DATABASE_URL=postgresql://medvisit:change-me-REQUIRED@localhost:5432/medvisit?schema=public
DATABASE_POOL_MAX=10

# ── Authentication ──────────────────────────────────────────────────────────
# REQUIRED in production, at least 32 characters: `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Public URL of the app (https://medvisit.example.com in production)
NEXTAUTH_URL=http://localhost:3000
# Optional: canonical URL used in emails/sitemap (defaults to NEXTAUTH_URL)
APP_URL=

# Optional Google sign-in (both or neither). Redirect URI:
#   {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Initial super administrator (created/updated by the migrate job) ───────
ADMIN_EMAIL=
# At least 12 characters; only required the first time the admin is created.
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator
# true = overwrite the existing admin's password with ADMIN_PASSWORD on the next
# start (account recovery). Set back to false afterwards.
ADMIN_RESET_PASSWORD=false

# ── AI (OpenAI) ─────────────────────────────────────────────────────────────
# Without a key the AI triage and assistant endpoints return 503.
OPENAI_API_KEY=
OPENAI_TRIAGE_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Email notifications (optional) ──────────────────────────────────────────
# Without SMTP_HOST, notifications are in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Wisal <no-reply@wisal.example.com>"

# ── Operations ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_MB=10
APP_PORT=3000
# Image tag. With prebuilt release images, set APP_IMAGE/MIGRATE_IMAGE, e.g.
#   APP_IMAGE=ghcr.io/<owner>/medvisit-app
#   MIGRATE_IMAGE=ghcr.io/<owner>/medvisit-migrate
APP_VERSION=1.0.0
APP_IMAGE=medvisit-app
MIGRATE_IMAGE=medvisit-migrate

# ── Demo data ───────────────────────────────────────────────────────────────
# true = load the demo dataset on first start (skipped if users already exist)
SEED_DEMO_DATA=false
# Password for all demo accounts
SEED_PASSWORD=MedVisit@2026
# true = show demo account shortcuts on the sign-in page (never in production)
DEMO_MODE=false

# ── HTTPS reverse proxy (docker compose --profile proxy) ───────────────────
# Public hostname whose DNS A/AAAA record points at this server. Set
# NEXTAUTH_URL=https://<DOMAIN> as well.
DOMAIN=medvisit.example.com
# Contact address for the Let's Encrypt account (defaults to admin@<DOMAIN>).
ACME_EMAIL=
# With the proxy enabled, keep the app port private: APP_PORT=127.0.0.1:3000

# ── Build behind a TLS-inspecting proxy (optional) ─────────────────────────
# Path to a PEM CA bundle used only during `docker compose build`, e.g.
# ./certs/corporate-ca.pem. Keep it inside the project directory.
BUILD_CA_CERT=
